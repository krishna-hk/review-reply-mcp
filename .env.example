# Copy this file to .env for local work. Never commit .env or real values.
# On the host, set these as secret or environment settings instead.

# --- Mode B (hosted AI). Leave empty until checkpoint 5. ---
# Create a separate key just for this project in the Anthropic Developer Console
# and set a low monthly spending limit there as the final safety net.
ANTHROPIC_API_KEY=

# Master switch for Mode B. Set to false to turn it off instantly.
MODE_B_ENABLED=false

# Our own spending cap inside the server, lower than the console limit.
MODE_B_MONTHLY_BUDGET_USD=

# Starting quotas per person. We replace these with measured numbers.
MODE_B_QUOTA_REVIEWS=100
MODE_B_QUOTA_DRAFTS=30

# --- Server and database ---
# Local development uses a file. Hosting decides the real value.
DATABASE_URL=file:./local.sqlite

# Secret used to sign personal connection links.
LINK_SECRET=

# Token for the admin helpers (create invites, view usage, switch Mode B off).
ADMIN_TOKEN=

# Upload limits
MAX_ROWS_PER_IMPORT=200
MAX_REVIEWS_PER_OWNER=2000
